{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
    "configurePresets": [
        {
            "name": "ninja-debug",
            "displayName": "Ninja (Debug)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "ninja-release",
            "displayName": "Ninja (Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "ninja-tests",
            "displayName": "Ninja (Debug + unit tests)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MOSAIC_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 17 2022",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build"
        }
    ],
    "buildPresets": [
        { "name": "ninja-debug", "configurePreset": "ninja-debug" },
        { "name": "ninja-release", "configurePreset": "ninja-release" },
        { "name": "ninja-tests", "configurePreset": "ninja-tests", "targets": ["MosaicTests"] },
        { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Release" }
    ],
    "testPresets": [
        {
            "name": "ninja-tests",
            "configurePreset": "ninja-tests",
            "output": { "outputOnFailure": true }
        }
    ]
}